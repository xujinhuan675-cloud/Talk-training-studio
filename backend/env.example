# Application Settings
APP_NAME=FastAPI Forge
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development
SECRET_KEY=your-secret-key-here-change-in-production
# Startup migration switch (recommended true for local development)
AUTO_RUN_MIGRATIONS=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true
WORKERS=4

# Database Configuration (nested)
DATABASE__URL=sqlite+aiosqlite:///./app.db  # Default local development DB (async SQLite)
# Alternative database URLs:
# DATABASE__URL=postgresql+asyncpg://user:password@localhost:5432/dbname  # PostgreSQL (async)
# DATABASE__URL=mysql+aiomysql://user:password@localhost:3306/dbname  # MySQL 8.0+ (async)
# DATABASE__URL=mysql+pymysql://user:password@localhost:3306/dbname   # MySQL (PyMySQL)

# Redis Configuration (nested, for caching/sessions)
REDIS__URL=redis://localhost:6379/0
REDIS__MAX_CONNECTIONS=10
REDIS__DEFAULT_TTL=300
REDIS__NAMESPACE=fastapi-forge

# Realtime / WebSocket
# 每连接发送队列上限（背压），避免慢连接阻塞事件循环
REALTIME_WS_SEND_QUEUE_MAX=100
# 队列溢出策略：drop_oldest | drop_new | disconnect
REALTIME_WS_SEND_OVERFLOW_POLICY=drop_oldest
# Pipecat realtime voice service config. The backend uses
# REALTIME_OPENAI_API_KEY, LLM__API_KEY, or OPENAI_API_KEY for Pipecat OpenAI STT/TTS/LLM.
REALTIME_PROVIDER=openai
REALTIME_API_KEY=
REALTIME_BASE_URL=https://api.openai.com/v1/realtime/calls
REALTIME_OPENAI_API_KEY=
REALTIME_OPENAI_MODEL=gpt-realtime-2.1
REALTIME_OPENAI_VOICE=marin
# Enables user transcript events for persistence while using Pipecat realtime audio.
REALTIME_OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
#
# Volcengine/Doubao full-duplex realtime inventory example. Do not enable this
# until a Volcengine realtime adapter is wired into the backend; OpenAI remains
# the only active speech-to-speech realtime runtime in this branch.
# REALTIME_PROVIDER=volcengine.doubao_realtime
# REALTIME_API_KEY=your-volcengine-speech-api-key
# REALTIME_BASE_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
# REALTIME_OPENAI_MODEL=1.2.6.0
# REALTIME_OPENAI_VOICE=your-volcengine-voice
# REALTIME_OPENAI_TRANSCRIPTION_MODEL=

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# NewAPI integration
NEWAPI_BASE_URL=https://newapi.flowguide.cc
# Service token used by the TalkWise backend when calling the NewAPI gateway.
# Browser login tokens are entered by users in the TalkWise user menu instead.
NEWAPI_ACCESS_TOKEN=
NEWAPI_GATEWAY_BASE_URL=https://newapi.flowguide.cc/v1
# Keep false for local mock-user development. Set true in NewAPI-backed deployments.
NEWAPI_AUTH_ENABLED=false
NEWAPI_AUTH_ALLOW_MOCK_FALLBACK=false
NEWAPI_AUTH_TIMEOUT_SECONDS=5
# Public notice/status reader. These requests never send gateway credentials.
NEWAPI_ANNOUNCEMENT_TIMEOUT_SECONDS=2
NEWAPI_ANNOUNCEMENT_CACHE_TTL_SECONDS=60
NEWAPI_ANNOUNCEMENT_MAX_ITEMS=20
NEWAPI_TALKWISE_CLIENT_ID=talkwise
NEWAPI_TALKWISE_CLIENT_SECRET=
NEWAPI_TALKWISE_AUTH_EXCHANGE_PATH=/api/talkwise/auth/exchange
NEWAPI_TALKWISE_REDIRECT_URI=
TALKWISE_SESSION_COOKIE_NAME=talkwise_session
TALKWISE_SESSION_TTL_SECONDS=28800
NEWAPI_DEFAULT_BUSINESS_ROLE=sales
NEWAPI_DEFAULT_TEAM_ID=newapi

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@example.com

# LLM Configuration (nested)
# Stakeholder business flows prefer this OpenAI-compatible client.
# For Pipecat realtime, LLM__PROVIDER=openrouter switches only the LLM
# processor to Pipecat's native OpenRouterLLMService. Browser microphone STT
# and spoken TTS still require speech-capable providers such as OpenAI.
LLM__PROVIDER=openai
LLM__API_KEY=your-openai-compatible-api-key
# LLM__BASE_URL=https://api.openai.com/v1
LLM__WIRE_API=chat_completions
LLM__DEFAULT_MODEL=gpt-4o-mini
LLM__USER_AGENT=TalkTrainingStudio/1.0
#
# Volcengine Ark / Doubao OpenAI-compatible LLM example. The generic LLM
# client uses the Chat Completions-compatible Ark endpoint.
# LLM__PROVIDER=volcengine
# LLM__API_KEY=your-volcengine-ark-api-key
# LLM__BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM__WIRE_API=chat_completions
# LLM__DEFAULT_MODEL=doubao-seed-1-6-250615

# Common OpenAI-compatible aliases are also supported as fallback:
# OPENAI_COMPATIBLE_API_KEY=your-openai-compatible-api-key
# OPENAI_COMPATIBLE_BASE_URL=https://your-gateway.example.com/v1
# OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
# OPENAI_API_KEY=your-openai-compatible-api-key
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# NEWAPI_ACCESS_TOKEN also works as the OpenAI-compatible gateway token when
# LLM__API_KEY / OPENAI_COMPATIBLE_API_KEY are omitted. In that case base URL
# defaults to NEWAPI_GATEWAY_BASE_URL, or NEWAPI_BASE_URL + /v1.

# Descriptor-only Agent/Tool/MCP inventory for readiness. This does not start
# MCP servers or execute tools; it only lets /training-studio/llm-registry
# report whether agent tool_ids / mcp_server_ids can be resolved.
# CAPABILITY_INVENTORY__TOOL_CONFIGS=[{"id":"crm.lookup","name":"CRM Lookup","requires_mcp":true,"mcp_server":"crm"}]
# CAPABILITY_INVENTORY__MCP_SERVERS=[{"id":"crm","name":"CRM MCP","transport":"stdio","command":"npx"}]
# CAPABILITY_INVENTORY__AGENT_CONFIG_SCAN_LIMIT=200

# Optional Anthropic fallback for stakeholder flows
# STAKEHOLDER__ANTHROPIC_API_KEY=your-anthropic-api-key

# Voice Configuration
# These settings are for the legacy voice config endpoints. Pipecat realtime
# currently validates STT/TTS separately from the OpenRouter LLM adapter above.
# STT defaults to the OpenAI-compatible LLM key/base URL above when these are omitted.
# Set these explicitly if your LLM gateway does not support /audio/transcriptions.
# When omitted, VOICE__STT_API_KEY falls back to VOICE__TTS_API_KEY, then LLM__API_KEY.
VOICE__STT_PROVIDER=whisper
# VOICE__STT_API_KEY=your-whisper-compatible-api-key
VOICE__STT_BASE_URL=https://openrouter.ai/api/v1
VOICE__STT_MODEL=openai/whisper-1
#
# Volcengine Doubao streaming ASR runtime example. This uses provider-native
# WebSocket ASR and requires audio in pcm, wav, ogg/opus, or mp3 format.
# VOICE__STT_PROVIDER=volcengine
# VOICE__STT_API_KEY=your-volcengine-speech-api-key
# VOICE__STT_BASE_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel
# VOICE__STT_MODEL=volc.bigasr.sauc.duration
#
# TTS is not inferred from LLM settings; configure it only when AI spoken replies are needed.
# VOICE__TTS_PROVIDER=minimax
# VOICE__TTS_API_KEY=your-tts-api-key
# VOICE__TTS_BASE_URL=
# VOICE__TTS_MODEL=speech-2.8-hd
#
# Volcengine Doubao streaming TTS runtime example. This uses provider-native
# HTTP chunked TTS and does not reuse LLM/OpenAI-compatible API keys.
# VOICE__TTS_PROVIDER=volcengine
# VOICE__TTS_API_KEY=your-volcengine-speech-api-key
# VOICE__TTS_BASE_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
# VOICE__TTS_MODEL=seed-tts-2.0
#
# OpenRouter TTS alternative. Fill only the API key after choosing a speech-capable model.
# VOICE__TTS_PROVIDER=openrouter
# VOICE__TTS_API_KEY=your-openrouter-api-key
# VOICE__TTS_BASE_URL=https://openrouter.ai/api/v1
# VOICE__TTS_MODEL=mistralai/voxtral-mini-tts-2603

# External API Keys
STRIPE_API_KEY=your-stripe-api-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=104857600  # 100MB in bytes
LOG_BACKUP_COUNT=5
CLIENT_EVENT_LOGGING_ENABLED=true
CLIENT_EVENT_LOGGING_MAX_PAYLOAD_BYTES=4096

# Observability - Metrics
METRICS__ENABLED=false
METRICS__ACCESS_TOKEN=

# Observability - Tracing
TRACING__ENABLED=false
TRACING__EXPORTER=otlp
TRACING__OTLP_ENDPOINT=http://otel-collector:4317
TRACING__SAMPLE_RATE=0.1
TRACING__EXPOSE_TRACE_ID=false

# Observability - Health
HEALTH__DB_TIMEOUT_SECONDS=3
HEALTH__REDIS_TIMEOUT_SECONDS=2
HEALTH__STORAGE_TIMEOUT_SECONDS=3
HEALTH__INCLUDE_DETAILS=true
HEALTH__ACCESS_TOKEN=

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=./uploads

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Storage Service Configuration (nested)
# Storage type: local, s3, oss
STORAGE__TYPE=local

# Common storage settings
STORAGE__BUCKET=my-bucket
STORAGE__REGION=us-east-1
STORAGE__ENDPOINT=https://s3.amazonaws.com
STORAGE__PUBLIC_BASE_URL=https://cdn.example.com

# AWS S3 Configuration
STORAGE__AWS_ACCESS_KEY_ID=your-aws-access-key
STORAGE__AWS_SECRET_ACCESS_KEY=your-aws-secret-key
STORAGE__S3_SSE=AES256
STORAGE__S3_ACL=private

# Aliyun OSS Configuration
STORAGE__OSS_ACCESS_KEY_ID=your-oss-access-key
STORAGE__OSS_ACCESS_KEY_SECRET=your-oss-secret-key

# Local Storage Configuration
STORAGE__LOCAL_BASE_PATH=/tmp/storage

# Storage Advanced Settings
STORAGE__MAX_RETRY_ATTEMPTS=3
STORAGE__TIMEOUT=30
STORAGE__ENABLE_SSL=true
STORAGE__PRESIGN_MAX_SIZE=104857600  # 100MB in bytes
STORAGE__VALIDATION_ENABLED=false
STORAGE__MAX_FILE_SIZE=104857600  # 100MB in bytes
STORAGE__ALLOWED_TYPES=["image/jpeg","image/png","application/pdf"]

# Messaging / Kafka Configuration (nested)
# Provider and driver
KAFKA__DRIVER=confluent  # or aiokafka

# Core Kafka
KAFKA__BOOTSTRAP_SERVERS=localhost:9092
KAFKA__CLIENT_ID=fastapi-forge
# Optional transactional producer (confluent only)
# KAFKA__TRANSACTIONAL_ID=fastapi-forge-txn-1

# TLS
KAFKA__TLS_ENABLE=false
# KAFKA__TLS_CA_LOCATION=/path/to/ca.pem
# KAFKA__TLS_CERTIFICATE=/path/to/cert.pem
# KAFKA__TLS_KEY=/path/to/key.pem
KAFKA__TLS_VERIFY=true

# SASL (set when broker requires auth)
# KAFKA__SASL_MECHANISM=PLAIN  # or SCRAM-SHA-256 / SCRAM-SHA-512
# KAFKA__SASL_USERNAME=username
# KAFKA__SASL_PASSWORD=password

# Producer tuning
KAFKA__PRODUCER_ACKS=all
KAFKA__PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA__PRODUCER_COMPRESSION_TYPE=zstd
KAFKA__PRODUCER_LINGER_MS=5
KAFKA__PRODUCER_BATCH_SIZE=65536
KAFKA__PRODUCER_MAX_IN_FLIGHT=5
KAFKA__PRODUCER_MESSAGE_TIMEOUT_MS=120000
KAFKA__PRODUCER_SEND_WAIT_S=5.0
KAFKA__PRODUCER_DELIVERY_WAIT_S=30.0

# Consumer tuning
KAFKA__CONSUMER_ENABLE_AUTO_COMMIT=false
KAFKA__CONSUMER_AUTO_OFFSET_RESET=latest
KAFKA__CONSUMER_MAX_POLL_INTERVAL_MS=300000
KAFKA__CONSUMER_SESSION_TIMEOUT_MS=45000
KAFKA__CONSUMER_FETCH_MIN_BYTES=1
KAFKA__CONSUMER_FETCH_MAX_BYTES=52428800
KAFKA__CONSUMER_COMMIT_EVERY_N=100
KAFKA__CONSUMER_COMMIT_INTERVAL_MS=2000
KAFKA__CONSUMER_MAX_CONCURRENCY=1
KAFKA__CONSUMER_INFLIGHT_MAX=1000

# Retry policy
KAFKA__RETRY_LAYERS=retry.5s:5000,retry.1m:60000,retry.10m:600000
KAFKA__RETRY_DLQ_SUFFIX=dlq


# gRPC Settings (nested)
GRPC__ENABLED=false
GRPC__HOST=0.0.0.0
GRPC__PORT=50051
# TLS (optional)
GRPC__TLS__ENABLED=false
# GRPC__TLS__CERT=/path/to/server.crt
# GRPC__TLS__KEY=/path/to/server.key
# GRPC__TLS__CA=/path/to/ca.crt
