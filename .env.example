# Copy this file to .env, or run start-dev.cmd to create/update local env files.

POSTGRES_USER=stakecoach
POSTGRES_PASSWORD=stakecoach_dev_password
POSTGRES_DB=stakecoachdb
POSTGRES_HOST_PORT=15432

BACKEND_PORT=8012
FRONTEND_PORT=5177

SECRET_KEY=dev-secret-change-me
DEBUG=true

# NewAPI integration
NEWAPI_BASE_URL=https://newapi.flowguide.cc
# Fill this with a NewAPI token used by TalkWise backend LLM calls.
NEWAPI_ACCESS_TOKEN=
# Optional override for the OpenAI-compatible relay gateway.
NEWAPI_GATEWAY_BASE_URL=https://newapi.flowguide.cc/v1
# Set true in deployments where TalkWise API requests must authenticate
# through NewAPI Dashboard Bearer tokens.
NEWAPI_AUTH_ENABLED=false
NEWAPI_AUTH_ALLOW_MOCK_FALLBACK=false
NEWAPI_AUTH_TIMEOUT_SECONDS=5
NEWAPI_TALKWISE_CLIENT_ID=talkwise
NEWAPI_TALKWISE_CLIENT_SECRET=
NEWAPI_TALKWISE_AUTH_EXCHANGE_PATH=/api/talkwise/auth/exchange
NEWAPI_TALKWISE_REDIRECT_URI=
TALKWISE_SESSION_COOKIE_NAME=talkwise_session
TALKWISE_SESSION_TTL_SECONDS=28800
VITE_NEWAPI_BASE_URL=https://newapi.flowguide.cc
VITE_NEWAPI_AUTH_ENABLED=false
VITE_NEWAPI_LOGIN_URL=https://newapi.flowguide.cc/login
# redirect: immediately leave TalkWise for NewAPI sign-in; external: show a
# manual NewAPI link; embedded: show NewAPI in an iframe and finish via handoff.
VITE_NEWAPI_LOGIN_MODE=embedded
VITE_NEWAPI_CONSOLE_URL=https://newapi.flowguide.cc
VITE_NEWAPI_USAGE_URL=https://newapi.flowguide.cc/usage-logs/common
VITE_NEWAPI_API_KEYS_URL=https://newapi.flowguide.cc/keys
VITE_NEWAPI_TALKWISE_CLIENT_ID=talkwise
VITE_NEWAPI_TALKWISE_REDIRECT_URI=
# Optional overrides for the OpenAI-compatible NewAPI gateway.
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_WIRE_API=chat_completions

# NewAPI staging compose override. Used with:
# docker compose -f docker-compose.yml -f docker-compose.newapi-staging.yml up -d
NEWAPI_IMAGE=ghcr.io/xujinhuan675-cloud/talkwise-newapi:talkwise-auth-handoff-210b1ad
NEWAPI_HOST_PORT=3000
NEWAPI_INTERNAL_BASE_URL=http://new-api:3000
NEWAPI_PUBLIC_BASE_URL=http://127.0.0.1:3000
NEWAPI_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:3000/v1
NEWAPI_POSTGRES_USER=newapi
NEWAPI_POSTGRES_PASSWORD=
NEWAPI_POSTGRES_DB=newapi
NEWAPI_REDIS_PASSWORD=
NEWAPI_SESSION_SECRET=
NEWAPI_SESSION_COOKIE_SECURE=false
NEWAPI_SESSION_COOKIE_TRUSTED_URL=
NEWAPI_TRUSTED_PROXIES=
NEWAPI_TALKWISE_REDIRECT_URIS=http://127.0.0.1:5177/login,http://localhost:5177/login,http://127.0.0.1:5178/login,http://localhost:5178/login
