# Copy to .env.newapi-staging and replace every *_PASSWORD, *_SECRET, and token value.
# Use with:
# docker compose --env-file .env.newapi-staging -f docker-compose.yml -f docker-compose.newapi-staging.yml up -d

POSTGRES_USER=stakecoach
POSTGRES_PASSWORD=
POSTGRES_DB=stakecoachdb
POSTGRES_HOST_PORT=15432

SECRET_KEY=
DEBUG=false

# TalkWise backend -> NewAPI handoff.
NEWAPI_AUTH_ENABLED=true
NEWAPI_AUTH_ALLOW_MOCK_FALLBACK=false
NEWAPI_AUTH_TIMEOUT_SECONDS=5
NEWAPI_INTERNAL_BASE_URL=http://new-api:3000
NEWAPI_BASE_URL=http://new-api:3000
NEWAPI_PUBLIC_BASE_URL=http://127.0.0.1:3000
NEWAPI_PUBLIC_GATEWAY_BASE_URL=http://127.0.0.1:3000/v1
NEWAPI_GATEWAY_BASE_URL=http://127.0.0.1:3000/v1
NEWAPI_USER_BILLING_ENABLED=true
NEWAPI_USER_RELAY_BASE_URL=http://new-api:3000/pg
NEWAPI_USER_RELAY_REALTIME_URL=ws://new-api:3000/pg/realtime
NEWAPI_TALKWISE_CLIENT_ID=talkwise
NEWAPI_TALKWISE_CLIENT_SECRET=
NEWAPI_TALKWISE_AUTH_EXCHANGE_PATH=/api/talkwise/auth/exchange
NEWAPI_TALKWISE_REDIRECT_URI=http://127.0.0.1:3000/training
TALKWISE_SESSION_COOKIE_NAME=talkwise_session
TALKWISE_SESSION_TTL_SECONDS=28800

# NewAPI staging service.
NEWAPI_IMAGE=ghcr.io/xujinhuan675-cloud/talkwise-newapi:talkwise-auth-handoff-210b1ad
NEWAPI_HOST_PORT=3000
NEWAPI_POSTGRES_USER=newapi
NEWAPI_POSTGRES_PASSWORD=
NEWAPI_POSTGRES_DB=newapi
NEWAPI_REDIS_PASSWORD=
NEWAPI_SESSION_SECRET=
NEWAPI_SESSION_COOKIE_SECURE=false
NEWAPI_SESSION_COOKIE_TRUSTED_URL=
NEWAPI_TRUSTED_PROXIES=
NEWAPI_TALKWISE_REDIRECT_URIS=http://127.0.0.1:3000/training,http://localhost:3000/training
TALKWISE_TRAINING_UPSTREAM_URL=http://app:8000

# Models and prices are configured as NewAPI channels. TalkWise forwards each
# signed-in user's short-lived dashboard token; no shared gateway key is used.
NEWAPI_ACCESS_TOKEN=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=http://new-api:3000/pg
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_WIRE_API=chat_completions
